# ─── Куда ходить за данными ───
# Приватный адрес бота внутри туннеля WireGuard. Наружу этот порт не смотрит.
PORTAL_API_BASE_URL=http://10.8.0.1:8080
PORTAL_API_TIMEOUT_SECONDS=10

# ─── Сессии ───
# Подставляется из compose, менять не нужно.
PORTAL_REDIS_URL=redis://portal_redis:6379/0
PORTAL_SESSION_COOKIE=portal_session
PORTAL_SESSION_TTL_SECONDS=604800
# false — только для локальной разработки по http.
PORTAL_COOKIE_SECURE=true

# ─── Как портал выглядит ───
PORTAL_PUBLIC_URL=https://portal.example.com
PORTAL_BRAND_NAME=Nizya VPN
PORTAL_DEFAULT_LANGUAGE=ru
PORTAL_SUPPORT_URL=

PORTAL_DEBUG=false

# ─── Для Caddy ───
# Домен портала: по нему выпускается сертификат.
PORTAL_DOMAIN=portal.example.com
